# Copy to .env.local and fill in real values there. .env.local is
# gitignored, never commit real keys.

# Kill switch. Stays "false" until the knowledge base gaps are filled and
# the evals have been reviewed. When false, the #ask section is entirely
# absent from the page (not just hidden by CSS).
CHAT_ENABLED=false

# Set to "true" to run the chat entirely against local mock data: no
# Anthropic key or Upstash database needed. The API route returns
# realistic canned `respond` payloads and uses an in-memory store instead
# of Redis. Useful for local UI/UX work; never set this in production.
CHAT_MOCK=false

# ─── Anthropic ─────────────────────────────────────────────────────────
# Create this key in the Claude Console with a monthly spend limit set.
ANTHROPIC_API_KEY=

# Model id. Defaults to Haiku 4.5 in code if unset; override to switch,
# e.g. to a Sonnet 5 snapshot.
CHAT_MODEL=claude-haiku-4-5-20251001

# ─── Upstash Redis (rate limiting + question logging) ─────────────────
# These are Upstash's own standard variable names (same ones their
# Vercel Marketplace integration writes automatically, if you connect it
# that way instead of pasting values by hand).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
